# CRM ON — modelo de variáveis de ambiente.
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Ao criar uma variável nova, adicione aqui e no .env.local (e no painel do
# provedor de deploy, quando existir um).

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<chave publishable/anon>"

# Service role — ignora RLS. SÓ no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada pelo motor de automações (/api/automations/tick).
SUPABASE_SERVICE_ROLE_KEY="<chave service_role>"

# --- Motor de automações ---
# Segredo do cabeçalho x-automation-secret. String aleatória de 32+ caracteres.
# O pg_cron envia esse valor ao chamar /api/automations/tick.
AUTOMATION_SECRET="<string aleatoria de 32+ caracteres>"

# --- E-mail transacional (Resend) ---
# EMAIL_FROM precisa usar um domínio SEU, verificado na sua conta do Resend.
# Não há domínio padrão embutido no código: sem esta variável o CRM simplesmente
# não envia (convite fica com aviso, automação de e-mail é pulada). O remetente
# de teste @resend.dev é ignorado de propósito — ele só entrega ao dono da conta.
RESEND_API_KEY="<chave do Resend>"
EMAIL_FROM="CRM ON <nao-responder@seudominio.com.br>"
# Reply-To dos transacionais (convites/automações). Não precisa ser do domínio
# verificado — é só para onde vão as respostas. Ex.: contato@suaempresa.com
EMAIL_REPLY_TO="<e-mail para respostas (opcional)>"

# --- Email Marketing ---
# Segredo do webhook do Resend (Resend → Webhooks → o endpoint /api/marketing/resend-webhook).
# Verifica a assinatura Svix dos eventos de entrega/abertura/clique. Privada.
RESEND_WEBHOOK_SECRET="<signing secret do webhook do Resend>"

# --- Pagamentos (Digital Manager Guru) ---
# Protege /api/integrations/guru/sync, chamada pelo pg_cron. Tem que ser o MESMO
# valor gravado em private.guru_sync_config.secret no Supabase — se um lado rotacionar
# sem o outro, o sync passa a responder 401.
GURU_SYNC_SECRET="<string aleatoria de 32+ caracteres>"

# --- App ---
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Google Ads (API oficial — Gerenciador de anúncios)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25

# IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp não oficial (Evolution API) ---
# Gateway próprio. A chave é global: com ela dá para criar, ler e apagar
# QUALQUER instância do gateway — inclusive de outros projetos que rodem nele.
EVOLUTION_API_URL="https://seu-gateway.exemplo"
EVOLUTION_API_KEY="<chave global do gateway>"
